{
  "_webhook_url_comment": "Chay 'AntiCryptoMinerd.exe --protect-webhook <url>' tren may dich, dan chuoi 'dpapi:...' in ra vao day. Khong luu URL dang plaintext.",
  "webhook_url": "",
  "scan_interval_seconds": 30,
  "confidence_threshold": 70,
  "entropy_threshold": 7.4,
  "entropy_sample_bytes": 65536,
  "dry_run": true,
  "enable_remediation": true,
  "enable_fim": true,
  "enable_driver_check": true,
  "enable_container_check": true,
  "enable_sysmon_telemetry": false,
  "gcp_shutdown_self": false,
  "gcp_delete_self": false,
  "gcp_shutdown_require_confirmation": false,
  "gcp_shutdown_confirm_timeout_seconds": 300,
  "gcp_project_id": "",
  "gcp_zone": "",
  "gcp_instance_name": "",
  "allowlist": ["python.exe", "ollama.exe"],
  "blacklist_ips": [],
  "pool_ports": [3333, 4444, 5555, 7777, 8000, 9000, 14444, 18081, 45700, 5588]
}
